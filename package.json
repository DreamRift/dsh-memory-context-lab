{
  "name": "dsh-memory-context-lab",
  "version": "0.15.4",
  "private": true,
  "description": "按会话启用的上下文管理（v3 单引擎）：原始历史全部可存、命中按需回注、观察面只读",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "vendor/dsh-ops",
    "vendor/bash-win32-x64",
    "README.md",
    "CHANGELOG.md",
    "INSTALL.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "pretest": "node scripts/require-test-dir.mjs",
    "test:all": "node scripts/test-all.mjs",
    "preprobe:host": "node scripts/require-test-dir.mjs",
    "probe:host": "node test/helpers/host-contract-probe.mjs",
    "pack:test": "node scripts/pack-test-package.mjs",
    "eval:v3frozen": "node scripts/v3-eval-frozen.mjs",
    "ab": "node scripts/v3-ab.mjs",
    "t2:smoke": "node scripts/t2-smoke.mjs",
    "t2:provider": "node scripts/t2-provider-smoke.mjs",
    "t2:backfill": "node scripts/t2-backfill-smoke.mjs",
    "bench:hotpath": "node scripts/bench-hotpath.mjs",
    "vendor:ops": "node scripts/vendor-ops.mjs",
    "prepack": "node scripts/vendor-ops.mjs --ensure"
  },
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "url": "https://github.com/DreamRift/dsh-memory-context-lab.git",
    "type": "git"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "dsh-ops": "file:./vendor/dsh-ops"
  },
  "optionalDependencies": {
    "@dsh-ops/bash-win32-x64": "file:./vendor/bash-win32-x64"
  }
}
