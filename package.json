{
  "name": "dsh-memory-context-lab",
  "version": "0.14.0-beta.50",
  "private": true,
  "description": "按会话启用的上下文管理（v3 单引擎）：原始历史全部可存、命中按需回注、观察面只读",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "url": "https://github.com/DreamRift/dsh-memory-context-lab.git",
    "type": "git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@furongjun1999/dsh-memory": ">=0.8.1 <0.10.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/cosmokit": "^1.8.5"
  },
  "peerDependenciesMeta": {
    "@furongjun1999/dsh-memory": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cosmokit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "pretest": "node scripts/require-test-dir.mjs",
    "test:all": "node scripts/test-all.mjs",
    "preprobe:host": "node scripts/require-test-dir.mjs",
    "probe:host": "node test/helpers/host-contract-probe.mjs",
    "pack:test": "node scripts/pack-test-package.mjs",
    "eval:v3frozen": "node scripts/v3-eval-frozen.mjs",
    "ab": "node scripts/v3-ab.mjs",
    "t2:smoke": "node scripts/t2-smoke.mjs",
    "t2:provider": "node scripts/t2-provider-smoke.mjs",
    "t2:backfill": "node scripts/t2-backfill-smoke.mjs"
  }
}
